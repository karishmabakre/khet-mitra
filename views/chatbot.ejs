    <script>
        // =========================
        // Profile modal functionality
        // =========================
        const profileBtn = document.getElementById('profileBtn');
        const modal = document.getElementById('profileModal');
        const closeBtn = document.querySelector('.close');

        if (profileBtn) {
            profileBtn.addEventListener('click', () => {
                modal.style.display = 'flex';
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                modal.style.display = 'none';
            });
        }

        window.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.style.display = 'none';
            }
        });
        // =========================
        // Chat functionality
        // =========================
        const chatInput = document.querySelector('#userInput');
        const chatButton = document.querySelector('#sendBtn');
        const chatMessages = document.querySelector('.chat-messages');

        // =========================
        // LocalStorage chat history
        // =========================
        let chatHistory = loadChatHistory();

        function saveChatHistory(messages) {
            localStorage.setItem("chatHistory", JSON.stringify(messages));
        }

        function loadChatHistory() {
            const data = localStorage.getItem("chatHistory");
            return data ? JSON.parse(data) : [];
        }

        function restoreChatHistory() {
            chatMessages.innerHTML = ""; // clear
            chatHistory.forEach(msg => {
                addMessage(msg.text, msg.sender);
            });
        }

        // ---- Restore chat on reload ----
        window.addEventListener('load', restoreChatHistory);

        // ---- Events ----
        chatButton.addEventListener('click', sendMessage);
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        // ---- Send message ----
        async function sendMessage() {
            const message = chatInput.value.trim();
            if (!message) return;

            // show user's message
            addMessage(message, 'user');
            chatInput.value = '';

            // show a temporary "typing" indicator
            const typingEl = addMessage('...', 'ai', true);

            try {
                const url = "http://localhost:5000/api/ask";
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: message })
                });

                const data = await resp.json();
                // remove typing indicator
                if (typingEl) typingEl.remove();

                if (!resp.ok) {
                    addMessage('Error: ' + (data.error || 'Something went wrong'), 'ai');
                    return;
                }

                const reply = (data.status == 'success') 
                    ? data.answer 
                    : (data.answer_en || "Sorry, I didn't get a response.");
                    console.log({reply});
                    
                addMessage(reply, 'ai');
            } catch (err) {
                if (typingEl) typingEl.remove();
                addMessage('Network error. Try again later.', 'ai');
                console.error(err);
            }
        }

        function addMessage(text, sender, isTemp = false) {
            const messageEl = document.createElement('div');
            messageEl.classList.add('message');
            messageEl.classList.add(sender === 'user' ? 'user-message' : 'ai-message');
            messageEl.textContent = text;

            chatMessages.appendChild(messageEl);
            chatMessages.scrollTop = chatMessages.scrollHeight; // auto-scroll

            if (!isTemp) {
                chatHistory.push({ sender, text });
                saveChatHistory(chatHistory);
            }

            return isTemp ? messageEl : null;
        }
        // =========================
        // Prewritten prompt auto-send
        // =========================
        document.querySelectorAll('.prompt-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                chatInput.value = chip.textContent.trim(); // fill input
                sendMessage(); // auto-send immediately
            });
        });
    </script>


