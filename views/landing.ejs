    <script>
        // Initialize AOS animations
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true,
            mirror: false
        });
    
        document.addEventListener('DOMContentLoaded', function () {
            const orbitContainer = document.getElementById('orbit-container');
            const centerX = orbitContainer.offsetWidth / 2;
            const centerY = orbitContainer.offsetHeight / 2;
            const radius = 150;
    
            const icons = [
                { name: 'sun', color: 'text-yellow-400' },
                { name: 'droplet', color: 'text-blue-400' },
                { name: 'thermometer', color: 'text-red-400' },
                { name: 'bar-chart-2', color: 'text-emerald-400' },
                { name: 'cloud-rain', color: 'text-blue-500' },
                { name: 'activity', color: 'text-green-500' }
            ];
    
            // Add orbiting icons
            icons.forEach((icon, index) => {
                const angle = (index * (360 / icons.length)) * (Math.PI / 180);
                const x = centerX + radius * Math.cos(angle) - 30;
                const y = centerY + radius * Math.sin(angle) - 30;
    
                const iconElement = document.createElement('div');
                iconElement.className = `icon-orbit glow ${icon.color}`;
                iconElement.style.left = `${x}px`;
                iconElement.style.top = `${y}px`;
                iconElement.innerHTML = `<i data-feather="${icon.name}" class="w-6 h-6"></i>`;
                orbitContainer.appendChild(iconElement);
    
                // Animate circular orbit
                anime({
                    targets: iconElement,
                    rotate: '360deg',
                    duration: 15000,
                    easing: 'linear',
                    loop: true,
                    transformOrigin: `${centerX}px ${centerY}px`
                });
            });
    
            // Render feather icons after adding them
            feather.replace();
    
            // Update icon positions on resize
            window.addEventListener('resize', function () {
                const newCenterX = orbitContainer.offsetWidth / 2;
                const newCenterY = orbitContainer.offsetHeight / 2;
    
                [...orbitContainer.children].forEach((iconElement, index) => {
                    const angle = (index * (360 / icons.length)) * (Math.PI / 180);
                    const x = newCenterX + radius * Math.cos(angle) - 30;
                    const y = newCenterY + radius * Math.sin(angle) - 30;
    
                    iconElement.style.left = `${x}px`;
                    iconElement.style.top = `${y}px`;
                });
            });
    
            // Breathing animation for central text
            anime({
                targets: '.animate-breathe',
                scale: [1, 1.02],
                opacity: [0.95, 1],
                duration: 3000,
                direction: 'alternate',
                loop: true,
                easing: 'easeInOutSine'
            });
    
            // Pulse animation for orbit rings
            anime({
                targets: '.orbit-ring',
                scale: [1, 1.05],
                opacity: [0.3, 0.5],
                duration: 4000,
                direction: 'alternate',
                loop: true,
                easing: 'easeInOutSine',
                delay: anime.stagger(500)
            });
        });
    </script>
    
