                    </div>
                </div>

                <!-- Price Card 3 -->
                <div class="bg-white rounded-xl shadow-md p-6 crop-card transition duration-300">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800">Potato</h3>
