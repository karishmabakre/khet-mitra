                        <button class="text-green-600 hover:text-green-800 text-sm font-medium">View Details</button>
                    </div>
                </div>

                <!-- Price Card 4 -->
                <div class="bg-white rounded-xl shadow-md p-6 crop-card transition duration-300">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800">Tomato</h3>
                            <p class="text-gray-500 text-sm">AP Mandi</p>
                        </div>
                        <span class="px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full">Grade C</span>
                    </div>
                    <div class="mt-4">
                        <p class="text-3xl font-bold text-gray-800">₹1,850 <span class="price-up text-sm">↑ 8.3%</span>
                        </p>
                        <p class="text-gray-500 text-sm mt-1">Avg: ₹1,750 | Min: ₹1,600</p>
                    </div>
