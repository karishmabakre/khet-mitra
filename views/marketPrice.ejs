                </div>
                <div>
                    <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
                    <ul class="space-y-2">
                        <li><a href="/landing" class="text-green-200 hover:text-white">Home</a></li>
                        <li><a href="/chatbot" class="text-green-200 hover:text-white">Chatbot</a></li>
                        <li><a href="/weatherCrop" class="text-green-200 hover:text-white">Weather & Crop Calendar</a>
