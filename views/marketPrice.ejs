            </div>
        </div>

        <!-- Dropdown Filter Section -->
        <!-- <div class="dropdown-container flex justify-center" data-aos="fade-up">
            <select id="cropSelect" class="border border-gray-300 rounded px-4 py-2">
                <option value="" disabled selected>Select Crop</option>
                 <option value="wheat">Wheat (Sharbati)</option>
                <option value="rice">Rice (Basmati)</option>
                <option value="maize">Maize</option>
                <option value="soybean">Soybean</option>
                <option value="cotton">Cotton</option> 
            </select>
        </div>
        
        -->




        <div class="dropdown-row" style="display: flex; justify-content: center; gap: 15px; margin-bottom: 20px;">
            <form action="/marketPrice/search" method="POST" style="display: flex; align-items: center; gap: 15px;">

                <!-- Commodity dropdown -->
                <div class="dropdown-container">
                    <select name="commodity" id="cropSelect">
                        <option value="" selected>Select Crop</option>
                        <% commodities.forEach(crop=> { %>
                            <option value="<%= crop %>">
                                <%= crop %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <!-- State dropdown -->
                <div class="dropdown-container">
                    <select name="state" id="stateSelect">
                        <option value="" selected>Select State</option>
                        <% states.forEach(st=> { %>
                            <option value="<%= st %>">
                                <%= st %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <!-- District dropdown -->
                <div class="dropdown-container">
                    <select name="district" id="districtSelect">
                        <option value="" selected>Select District</option>
                        <% districts.forEach(d=> { %>
                            <option value="<%= d %>">
                                <%= d %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <!-- Search button -->
                <div class="search-button-container">
                    <button type="submit"
                        style="padding: 10px 20px; border-radius: 8px; background: #16a34a; color: white; font-weight: 600; border: none; cursor: pointer;">
                        Search
                    </button>
                </div>
                

            </form>
        </div>

        <!-- Table to show results -->
        <div class="results-container" style="margin-top: 30px;">
            <% if (results && results.length> 0) { %>
                <table border="1" cellpadding="10" cellspacing="0"
                    style="width: 100%; border-collapse: collapse; text-align: center;">
                    <thead style="background: #16a34a; color: white;">
                        <tr>
                            <th>Commodity</th>
                            <th>State</th>
                            <th>District</th>
                            <th>Market</th>
                            <th>Min Price</th>
                            <th>Max Price</th>
                            <th>Modal Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% results.forEach(r=> { %>
                            <tr>
                                <td>
                                    <%= r.commodity %>
                                </td>
                                <td>
                                    <%= r.state %>
                                </td>
                                <td>
                                    <%= r.district %>
                                </td>
                                <td>
                                    <%= r.market %>
                                </td>
                                <td class="price-down">
                                    <%= r.min_price %>
                                </td>
                                <td class="price-up">
                                    <%= r.max_price %>
                                </td>
                                <td>
                                    <%= r.modal_price %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
                <% } else { %>
                    <p style="text-align: center; margin-top: 20px;">No results found. Please select filters and search.
                    </p>
                    <% } %>
        </div>

        <!-- 🔽 Cascading Dropdown Script -->
        <script>
            const cropSelect = document.getElementById("cropSelect");
            const stateSelect = document.getElementById("stateSelect");
            const districtSelect = document.getElementById("districtSelect");

            // When crop changes → update states
            cropSelect.addEventListener("change", async () => {
                const crop = cropSelect.value;
                const res = await fetch(`/api/states?commodity=${encodeURIComponent(crop)}`);
                const states = await res.json();

                stateSelect.innerHTML = `<option value="">Select State</option>`;
                states.forEach(st => {
                    stateSelect.innerHTML += `<option value="${st}">${st}</option>`;
                });

                // reset districts
                districtSelect.innerHTML = `<option value="">Select District</option>`;
            });

            // When state changes → update districts (based on crop + state)
            stateSelect.addEventListener("change", async () => {
                const crop = cropSelect.value;
                const state = stateSelect.value;
                const res = await fetch(`/api/districts?commodity=${encodeURIComponent(crop)}&state=${encodeURIComponent(state)}`);
                const districts = await res.json();

                districtSelect.innerHTML = `<option value="">Select District</option>`;
                districts.forEach(d => {
                    districtSelect.innerHTML += `<option value="${d}">${d}</option>`;
                });
            });
        </script>



        <!-- Price Trends -->
        <div class="mb-12" data-aos="fade-up">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                <i data-feather="activity" class="mr-2"></i> Price Trends
            </h2>
            <div class="bg-white rounded-xl shadow-md p-6">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800"></h3>
                        <p class="text-gray-500 text-sm"></p>
                    </div>
                    <div class="flex space-x-2">
                        <button class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">7D</button>
                        <button class="px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm">30D</button>
                        <button class="px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm">90D</button>
                    </div>
                </div>
                <div class="h-64">
                    <canvas id="priceChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Recommendations -->
        <div class="mb-12" data-aos="fade-up">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                <i data-feather="award" class="mr-2"></i> Smart Recommendations
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white rounded-xl shadow-md p-6">
                    <div class="flex items-center mb-4">
                        <div class="p-3 bg-blue-100 rounded-full mr-4">
                            <i data-feather="clock" class="text-blue-600"></i>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-800">Best Selling Time</h3>
                    </div>
                    <p class="text-gray-600 mb-4">Prices expected to rise 8-10% in next 3 days due to festival demand.
                    </p>
                    <div class="flex items-center text-sm text-blue-600">
                        <i data-feather="alert-circle" class="mr-2"></i>
                        <span>Sell between 15-18 Nov for maximum profit</span>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-md p-6">
                    <div class="flex items-center mb-4">
                        <div class="p-3 bg-green-100 rounded-full mr-4">
                            <i data-feather="map-pin" class="text-green-600"></i>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-800">Top Market Pick</h3>
                    </div>
                    <p class="text-gray-600 mb-4">Azadpur Mandi offering ₹150/quintal more than local markets.</p>
                    <div class="flex items-center text-sm text-green-600">
                        <i data-feather="check-circle" class="mr-2"></i>
                        <span>Net profit after transport: ₹95/quintal</span>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-md p-6">
                    <div class="flex items-center mb-4">
                        <div class="p-3 bg-purple-100 rounded-full mr-4">
                            <i data-feather="bar-chart-2" class="text-purple-600"></i>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-800">Storage Advice</h3>
                    </div>
                    <p class="text-gray-600 mb-4">Current storage costs outweigh potential price gains.</p>
                    <div class="flex items-center text-sm text-purple-600">
                        <i data-feather="alert-triangle" class="mr-2"></i>
                        <span>Recommend selling now rather than storing</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-green-800 text-white py-12">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4 flex items-center">
                        KhetMitra
                    </h3>
                    <p class="text-green-200">Helping farmers optimize their crops with smart technology and data-driven
