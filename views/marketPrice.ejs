                    </p>
                </div>
                <div>
                    <h3 class="text-lg font-semibold mb-4">Connect With Us</h3>
                    <p class="text-green-200">Toll-free: 0000000000</p>
                    <!-- <p class="text-green-200">support@krishibazaar.in</p> -->
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-8 text-center text-green-200">
                <p>© 2025 KhetMitra. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Initialize AOS
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true,
            mirror: false
        });

        // Initialize Feather Icons
        feather.replace();

        // Sample search functionality
        document.getElementById('cropSearch').addEventListener('input', function (e) {
            const searchTerm = e.target.value.toLowerCase();
            const resultsContainer = document.getElementById('searchResults');

            if (searchTerm.length > 2) {
                // Simulate search results
                const crops = ['Wheat', 'Rice', 'Potato', 'Tomato', 'Onion', 'Maize', 'Soybean', 'Cotton'];
                const filtered = crops.filter(crop => crop.toLowerCase().includes(searchTerm));

                if (filtered.length > 0) {
                    resultsContainer.innerHTML = filtered.map(crop => `
                        <div class="p-3 hover:bg-gray-100 cursor-pointer border-b border-gray-100 last:border-b-0">
                            <div class="flex items-center">
                                <i data-feather="search" class="text-gray-500 mr-2"></i>
                                <span>${crop}</span>
                            </div>
                        </div>
                    `).join('');
                    resultsContainer.classList.remove('hidden');
                } else {
                    resultsContainer.innerHTML = `
                        <div class="p-3 text-gray-500">
                            No results found for "${searchTerm}"
                        </div>
                    `;
                    resultsContainer.classList.remove('hidden');
                }
            } else {
                resultsContainer.classList.add('hidden');
            }
        });

        // Close search results when clicking outside
        document.addEventListener('click', function (e) {
            if (!document.getElementById('cropSearch').contains(e.target) &&
                !document.getElementById('searchResults').contains(e.target)) {
                document.getElementById('searchResults').classList.add('hidden');
            }
        });

        // Price Chart
        const ctx = document.getElementById('priceChart').getContext('2d');
        const priceChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Price (₹/quintal)',
                    data: [2300, 2350, 2400, 2420, 2450, 2430, 2470],
                    borderColor: '#10B981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        grid: {
                            drawBorder: false
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    </script>
</body>

</html>